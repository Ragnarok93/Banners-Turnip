From 4e0d4a16bfe4c9e6b3ad1f7f9a63d2b3b42d2a01 Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Fri, 16 Oct 2026 00:00:00 +0000
Subject: [PATCH] tu/kgsl: align heap budget with VA size and clean failed sparse BOs

On KGSL, kgsl_bo_init() allocates a BO before attempting a lazy sparse-VMA
bind. If IOCTL_KGSL_GPUMEM_BIND_RANGES fails, the function currently
returns the error without freeing the newly allocated BO. Repeated failed
binds can therefore retain KGSL allocations and worsen memory pressure.

Query KGSL_PROP_GPU_VA64_SIZE before calculating the Vulkan heap size.
The heap-size helper clamps to physical_device->va_size when it is known,
but the KGSL path previously populated va_size only after calculating the
heap, silently skipping that clamp. Report the address-space limit to Vulkan
when the kernel supplies one.

Log the resulting heap budget and GPU VA size once during KGSL device setup.
Include the requested byte size in the GPUMEM_ALLOC_ID, GPUMEM_BIND_RANGES,
and dma-heap allocation failure messages, so OOM captures distinguish a
backing BO allocation failure from a sparse VA bind failure.

Emit the BO allocation RMV event once the kernel allocation is established,
before mapping, so failure cleanup has a matching destroy event. On sparse
bind failure, release the unbound BO through kgsl_bo_finish(). Keep the
replayable mapping path unchanged because kgsl_bo_user_map() already cleans
up its BO on failure.

This patch is intentionally limited to heap-budget accuracy, failure
diagnostics, and the sparse-bind error unwind. It does not add retries or
reclaim live allocations.

---
 src/freedreno/vulkan/tu_knl_kgsl.cc | 28 ++++++++++++++++++++--------
 1 file changed, 19 insertions(+), 9 deletions(-)

diff --git a/src/freedreno/vulkan/tu_knl_kgsl.cc b/src/freedreno/vulkan/tu_knl_kgsl.cc
--- a/src/freedreno/vulkan/tu_knl_kgsl.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl.cc
@@ -247,8 +248,9 @@ kgsl_sparse_vma_map(struct tu_device *dev,
    ret = safe_ioctl(dev->physical_device->local_fd,
                     IOCTL_KGSL_GPUMEM_BIND_RANGES, &req);
    if (ret) {
-      return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
-                       "GPUMEM_BIND_RANGES failed (%s)", strerror(errno));
+      return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                       "GPUMEM_BIND_RANGES failed for %llu bytes (%s)",
+                       (unsigned long long)range.length, strerror(errno));
    }
 
    return VK_SUCCESS;
@@ -339,8 +341,9 @@ kgsl_bo_init(struct tu_device *dev,
    ret = safe_ioctl(dev->physical_device->local_fd,
                     IOCTL_KGSL_GPUMEM_ALLOC_ID, &req);
    if (ret) {
-      return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
-                       "GPUMEM_ALLOC_ID failed (%s)", strerror(errno));
+      return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                       "GPUMEM_ALLOC_ID failed for %llu bytes (%s)",
+                       (unsigned long long)size, strerror(errno));
    }
 
    struct tu_bo* bo = tu_device_lookup_bo(dev, req.id);
@@ -369,22 +372,26 @@ kgsl_bo_init(struct tu_device *dev,
       .base = base,
    };
 
    tu_dump_bo_init(dev, bo);
 
+   /* The kernel BO exists now, including on a later mapping failure. */
+   TU_RMV(bo_allocate, dev, bo);
    VkResult result = VK_SUCCESS;
 
    if (lazy_vma) {
       result = kgsl_sparse_vma_map(dev, lazy_vma, bo, 0);
+      if (result != VK_SUCCESS) {
+         kgsl_bo_finish(dev, bo);
+         return result;
+      }
    } else if (flags & TU_BO_ALLOC_REPLAYABLE) {
       result = kgsl_bo_user_map(dev, bo, client_iova);
+      if (result != VK_SUCCESS)
+         return result; /* kgsl_bo_user_map() already frees the BO on failure. */
    }
 
-   if (result != VK_SUCCESS)
-      return result;
-
    *out_bo = bo;
 
-   TU_RMV(bo_allocate, dev, bo);
    if (flags & TU_BO_ALLOC_INTERNAL_RESOURCE) {
       TU_RMV(internal_resource_create, dev, bo);
       TU_RMV(resource_name, dev, bo, name);
@@ -1994,1 +1994,3 @@
+   get_kgsl_prop(fd, KGSL_PROP_GPU_VA64_SIZE, &device->va_size,
+                 sizeof(device->va_size));
    device->heap.size = tu_get_system_heap_size(device);
